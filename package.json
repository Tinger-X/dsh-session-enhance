{
  "name": "dsh-session-enhance",
  "version": "0.3.0",
  "description": "Conversation-enhance plugin for DeepSeek Harness Web: archive & preview sessions, guaranteed physical delete, drag-and-drop session moves between workspaces, conversation notifications, copy session ID, and a branchable conversation tree.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./workspace": "./lib/workspace.js",
    "./projcache": "./lib/projcache.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/check-package.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test scripts/*.test.mjs",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm build && pnpm test",
    "update:se": "dsh plugin --profile web remove dsh-session-enhance && pnpm build:client && dsh plugin --profile web add ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.2-rc.1",
    "@deepseek-ai/dsh-spill-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.2-rc.1",
    "@deepseek-ai/dsh-spill-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "esbuild": "^0.28.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tinger-X/dsh-session-enhance.git"
  },
  "homepage": "https://github.com/Tinger-X/dsh-session-enhance#readme",
  "bugs": {
    "url": "https://github.com/Tinger-X/dsh-session-enhance/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "archive",
    "session-enhance",
    "physical-delete",
    "drag-drop",
    "cordis",
    "typert",
    "workspace",
    "nodejs",
    "esm"
  ]
}
